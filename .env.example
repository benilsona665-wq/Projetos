# PORT: Porto HTTP do servidor Express (predefinido: 3000)
PORT=3000

# SESSION_SECRET: Obrigatório em produção (mínimo 32 caracteres aleatórios). Configure no Gestor de Segredos do alojamento.
SESSION_SECRET=""

# STRICT_PRODUCTION: Defina como "true" em produção definitiva para impedir arranque sem DATABASE_URL e SESSION_SECRET forte
STRICT_PRODUCTION="false"

# DATABASE_URL: String de ligação PostgreSQL partilhada obrigatória em produção definitiva (Cloud SQL, Neon, Supabase, Railway, Render)
# Exemplo: postgresql://utilizador:palavra_passe@anfitriao:5432/ancora_sms
# Em desenvolvimento local (ou pré-publicação sem PostgreSQL configurado), se ficar vazio, utiliza SQLite em DATABASE_PATH.
DATABASE_URL=""

# DATABASE_SSL: Defina como "true" se o fornecedor PostgreSQL exigir TLS/SSL
DATABASE_SSL="false"

# DATABASE_PATH: Caminho do ficheiro SQLite local (apenas desenvolvimento/migração)
DATABASE_PATH="./data/ancora-sms.sqlite"

# Arranque inicial (usado apenas na primeira inicialização se a base de dados estiver vazia)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
SEED_DEMO_DATA="false"

# Cópias de segurança automáticas diárias (Armazenamento externo compatível com S3: GCS Interop, Cloudflare R2, AWS S3, Backblaze B2)
BACKUP_ENABLED="false"
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="ancora-sms/backups"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS="30"
BACKUP_SCHEDULE_HOUR_UTC="02"
BACKUP_CRON_SECRET=""

# APP_URL: URL público HTTPS onde a aplicação está hospedada
APP_URL="MY_APP_URL"

# Facturação Eletrónica AGT (Angola — Decreto Presidencial n.º 71/25 e Decreto Executivo n.º 683/25)
# Mantenha todas as credenciais e chaves privadas apenas nos segredos do servidor (nunca no código-fonte ou navegador)
AGT_ENV="NAO_CONFIGURADO"
AGT_API_BASE_URL=""
AGT_API_USERNAME=""
AGT_API_PASSWORD=""
AGT_SOFTWARE_PRODUCT_ID="AncoraSMS"
AGT_SOFTWARE_PRODUCT_VERSION="1.0.0"
AGT_SOFTWARE_VALIDATION_NUMBER=""
AGT_PRIVATE_KEY_PEM=""
AGT_SOFTWARE_PRIVATE_KEY_PEM=""

